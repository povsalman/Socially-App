<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:id="@+id/main"
    tools:context=".PersonaldmActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:id="@+id/back_icon"
            android:src="@drawable/chevron_left"
            android:contentDescription="@string/back_arrow_desc"
            app:tint="@color/text_color" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/chat_profile_image"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/person1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">
            
            <TextView
                android:id="@+id/username_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/karennne"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black" />
            
            <TextView
                android:id="@+id/online_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offline"
                android:textSize="12sp"
                android:textColor="@color/gray" />
        </LinearLayout>

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:id="@+id/voice_call_icon"
            android:src="@drawable/voicerec"
            android:layout_marginEnd="16dp"
            android:contentDescription="Voice call"
            app:tint="@color/text_color" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:id="@+id/videocall_icon"
            android:src="@drawable/video"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/video_call_desc"
            app:tint="@color/text_color" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/info"
            android:contentDescription="@string/info_desc"
            app:tint="@color/text_color" />
    </LinearLayout>
    
    <!-- Vanish Mode Indicator -->
    <LinearLayout
        android:id="@+id/vanish_mode_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#9C27B0"
        android:padding="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 Vanish Mode Active"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- RecyclerView for messages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messages_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        android:scrollbars="none"
        android:clipToPadding="false" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="center_vertical">
        
        <com.google.android.material.button.MaterialButton
            android:id="@+id/vanish_mode_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Vanish"
            android:textSize="12sp"
            android:paddingHorizontal="12dp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:strokeColor="@color/text_color"
            app:strokeWidth="1dp"
            android:textColor="@color/text_color" />

        <ImageView
            android:id="@+id/camera_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/camera"
            android:layout_toEndOf="@id/vanish_mode_button"
            android:layout_marginStart="8dp"
            android:layout_centerVertical="true"
            android:contentDescription="@string/camera_input_desc"
            app:tint="@color/text_color" />

        <EditText
            android:id="@+id/message_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/camera_icon"
            android:layout_toStartOf="@id/mic_icon"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/input_background"
            android:hint="@string/message_input_hint"
            android:textSize="16sp"
            android:textColorHint="@color/gray"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp" />

        <ImageView
            android:id="@+id/mic_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/voicerec"
            android:layout_toStartOf="@id/gallery_icon"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            app:tint="@color/text_color" />

        <ImageView
            android:id="@+id/gallery_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/picture"
            android:layout_toStartOf="@id/send_button"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            app:tint="@color/text_color" />

        <ImageView
            android:id="@+id/send_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/send"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/text_color"
            android:contentDescription="Send message" />
    </RelativeLayout>

</LinearLayout>