<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="5dp">

        <TextView
            android:id="@+id/profile_username_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/profile_username"
            android:textStyle="bold"
            android:textColor="@color/text_color"
            android:textSize="18sp"
            android:gravity="center_horizontal" />

        <ImageView
            android:id="@+id/menu_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/menu"
            android:contentDescription="Menu"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            app:tint="@color/text_color" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="5dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/profile_image"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/jacob_img" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginStart="16dp">

            <TextView 
                android:id="@+id/posts_count_text"
                style="@style/ProfileStatsText" 
                android:text="@string/profile_posts" />
            <TextView 
                android:id="@+id/followers_count_text"
                style="@style/ProfileStatsText" 
                android:text="@string/profile_followers" />
            <TextView 
                android:id="@+id/following_count_text"
                style="@style/ProfileStatsText" 
                android:text="@string/profile_following" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp">

        <TextView 
            android:id="@+id/profile_name_text"
            style="@style/ProfileName" 
            android:text="@string/profile_name" />
        <TextView 
            android:id="@+id/profile_bio_text"
            style="@style/ProfileDescription" 
            android:text="@string/profile_description" />

        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:id="@+id/edit_profile_button"
            android:layout_marginTop="16dp"
            android:background="@drawable/edit_profile_button"
            android:text="@string/edit_profile_button"
            android:textAllCaps="false"
            android:textColor="@color/text_color"
            android:textAlignment="center"
            android:textSize="14dp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

    </LinearLayout>

    <!-- Story Highlight Items (Horizontally Scrollable) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="0dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout style="@style/StoryHighlightItem">
                <TextView
                    android:id="@+id/circle_2"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/ringcircle"
                    android:text="+"
                    android:textColor="@color/text_color"
                    android:textSize="30sp"
                    android:gravity="center" />
                <TextView style="@style/StoryHighlightText" android:text="@string/stories_new" />
            </LinearLayout>

            <LinearLayout style="@style/StoryHighlightItem">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/highlight_image_1"
                    style="@style/StoryHighlightImage" android:src="@drawable/exp14" />
                <TextView style="@style/StoryHighlightText" android:text="@string/stories_friends" />
            </LinearLayout>

            <LinearLayout style="@style/StoryHighlightItem">
                <de.hdodenhof.circleimageview.CircleImageView style="@style/StoryHighlightImage" android:src="@drawable/exp12" />
                <TextView style="@style/StoryHighlightText" android:text="@string/stories_travel" />
            </LinearLayout>

            <LinearLayout style="@style/StoryHighlightItem">
                <de.hdodenhof.circleimageview.CircleImageView style="@style/StoryHighlightImage" android:src="@drawable/exp20" />
                <TextView style="@style/StoryHighlightText" android:text="@string/stories_food" />
            </LinearLayout>

            <LinearLayout style="@style/StoryHighlightItem">
                <de.hdodenhof.circleimageview.CircleImageView style="@style/StoryHighlightImage" android:src="@drawable/exp11" />
                <TextView style="@style/StoryHighlightText" android:text="@string/stories_pets" />
            </LinearLayout>

            <LinearLayout style="@style/StoryHighlightItem">
                <de.hdodenhof.circleimageview.CircleImageView style="@style/StoryHighlightImage" android:src="@drawable/exp18" />
                <TextView style="@style/StoryHighlightText" android:text="@string/stories_memories" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:paddingTop="8dp">
        <ImageView
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:src="@drawable/grid"
            app:tint="@color/text_color" />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:src="@drawable/tag"
            app:tint="@color/gray" />
    </LinearLayout>

    <!-- RecyclerView for user's posts -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/profile_posts_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:scrollbars="none" />

</LinearLayout>